# Front-end (Vite) — só chaves públicas aqui, nunca segredos
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_CLIENT_ID=

# Backend (api/, Vercel Functions) — nunca commitar valores reais
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Provedor de IA — hoje usando OpenRouter (compatível com o formato OpenAI)
# enquanto a MiniMax M3 não está configurada. Para trocar de provedor, só
# muda essas três variáveis.
AI_API_KEY=
AI_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=openai/gpt-4o-mini
